VIDEO_PROCESSOR_HOST="0.0.0.0"
PORT="8080"
# Optional shared secret checked via X-Processor-Key header when set
VIDEO_PROCESSOR_API_KEY=""
FFMPEG_BIN="ffmpeg"
FFPROBE_BIN="ffprobe"
TEMP_DIR="/tmp/ai-studio-video-processor"
MAX_UPLOAD_MB="500"
FFPROBE_TIMEOUT_SEC="30"
FFMPEG_TIMEOUT_SEC="180"
WHISPER_MODEL_SIZE="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
