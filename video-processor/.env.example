APP_ENV="development"
VIDEO_PROCESSOR_HOST="127.0.0.1"
PORT="8001"
# Required when APP_ENV=production (minimum 16 characters); checked via X-Processor-Key header
VIDEO_PROCESSOR_API_KEY=""
FFMPEG_BIN="ffmpeg"
FFPROBE_BIN="ffprobe"
TEMP_DIR="/tmp/ai-studio-video-processor"
MAX_UPLOAD_MB="500"
FFPROBE_TIMEOUT_SEC="30"
FFMPEG_TIMEOUT_SEC="300"
MAX_CONCURRENT_EXPORTS="2"
EXPORT_QUEUE_WAIT_SEC="2.0"
MAX_TEMP_STORAGE_MB="2048"
TEMP_CLEANUP_MAX_AGE_SEC="3600"
WHISPER_MODEL_SIZE="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
