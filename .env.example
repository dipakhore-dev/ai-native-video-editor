PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local MongoDB or free MongoDB Atlas M0 URI
MONGODB_URI=mongodb://127.0.0.1:27017/ai_studio

# Set a random 32+ character signing secret in local .env
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=ai_studio_token

# Gemini API configuration (set GEMINI_API_KEY in local .env; leave fallback empty unless needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
AI_REQUEST_TIMEOUT_MS=25000

# Local Python FastAPI + FFmpeg + faster-whisper service
VIDEO_PROCESSOR_URL=http://127.0.0.1:8001
VIDEO_PROCESSOR_API_KEY=
VIDEO_UPLOAD_MAX_MB=500

# Optional Redis (leave empty to run synchronously without Redis)
REDIS_URL=

# Optional free stock media provider (default: none; set STOCK_MEDIA_PROVIDER=pexels + PEXELS_API_KEY)
STOCK_MEDIA_PROVIDER=none
PEXELS_API_KEY=
STOCK_MEDIA_REQUEST_TIMEOUT_MS=15000
STOCK_MEDIA_MAX_RESULTS=15
STOCK_MEDIA_MAX_IMPORT_MB=80

# Optional external paid video generation provider (leave empty for free mode)
VIDEO_GEN_PROVIDER_URL=

# Free local offline TTS & storyboard voiceover generation (Phase 5.5.3)
TTS_ENABLED=true
TTS_PROVIDER=auto
TTS_DEFAULT_LANGUAGE=en
TTS_MAX_TEXT_CHARS=1500
TTS_MAX_CONCURRENT_JOBS=1
TTS_REQUEST_TIMEOUT_MS=45000
TTS_MAX_BATCH_SCENES=12
TTS_MAX_AUDIO_MB=25
RATE_LIMIT_TTS_MAX=36

# Automatic caption generation & storyboard caption editor (Phase 5.5.4)
CAPTIONS_ENABLED=true
CAPTIONS_DEFAULT_MODE=script
CAPTIONS_MAX_TEXT_CHARS=4000
CAPTIONS_MAX_SEGMENTS_PER_SCENE=100
CAPTIONS_MAX_BATCH_SCENES=12
CAPTIONS_MAX_CONCURRENT_JOBS=1
CAPTIONS_REQUEST_TIMEOUT_MS=120000
CAPTIONS_MAX_AUDIO_MB=20
RATE_LIMIT_CAPTIONS_MAX=36
