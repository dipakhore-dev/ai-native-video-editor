# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for persistent MERN backend features.
# Example local URI: mongodb://127.0.0.1:27017/ai_studio
MONGODB_URI=""

# JWT_SECRET: Random secret (minimum 16 characters) used to sign HTTP-only auth cookies.
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="ai_studio_token"

# VIDEO_PROCESSOR_URL: Public HTTPS base URL of your deployed Python FastAPI FFmpeg/FFprobe service (e.g. Cloud Run)
VIDEO_PROCESSOR_URL=""
# Optional shared key sent in X-Processor-Key header to the Python microservice
VIDEO_PROCESSOR_API_KEY=""
VIDEO_UPLOAD_MAX_MB="500"

# REDIS_URL: Optional external Redis connection string for BullMQ background video jobs (e.g. rediss://...)
REDIS_URL=""
